{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -Command \"& (Join-Path (& git rev-parse --show-toplevel) '.codex/hooks/stop-verification-gate.ps1')\"",
            "commandWindows": "pwsh -NoProfile -Command \"& (Join-Path (& git rev-parse --show-toplevel) '.codex/hooks/stop-verification-gate.ps1')\"",
            "timeout": 60,
            "statusMessage": "Checking verification receipt freshness"
          }
        ]
      }
    ]
  }
}
